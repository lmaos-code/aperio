# Obsidian Sync Configuration
# Get your token: docker run --rm -it --entrypoint get-token ghcr.io/belphemur/obsidian-headless-sync-docker:latest
OBSIDIAN_AUTH_TOKEN=your-token-here

# Vault name (must match your remote vault exactly)
VAULT_NAME=Obsidian

# Host path where vault files will be synced to
VAULT_HOST_PATH=./dev/vault

# Container path for the vault
VAULT_PATH=/vault

# User/Group ID for file ownership
PUID=1000
PGID=1000
